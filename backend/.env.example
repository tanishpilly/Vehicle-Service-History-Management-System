# Backend Environment Variables
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_change_in_production_min32chars

# Cloud PostgreSQL (Neon / Supabase / Railway)
DATABASE_URL=postgresql://user:password@host/vehicle_service_db?sslmode=require

# Local PostgreSQL Fallback
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=12345
PGDATABASE=vehicle_service_db

# Cloudinary Storage for Insurance Documents
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
