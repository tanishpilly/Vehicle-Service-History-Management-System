# ========================================================
# VEHICLE SERVICE HISTORY MANAGEMENT SYSTEM
# Production & Local Environment Variables Configuration
# ========================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Option A: Cloud Database URL (Neon / Supabase / Railway / Aiven) [RECOMMENDED FOR VERCEL]
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/vehicle_service_db?sslmode=require

# Option B: Local Discrete PostgreSQL Variables (Fallback for Local Development)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=12345
PGDATABASE=vehicle_service_db

# 2. SERVER & SECURITY
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_change_in_production_min32chars

# 3. CLOUDINARY FILE STORAGE (For Insurance Documents on Serverless Vercel)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. FRONTEND CLIENT CONFIGURATION (Vite)
# Leave empty or set to /api for unified Vercel deployment
VITE_API_URL=/api

# Production public URL for Vehicle QR code scanning (e.g. https://your-app.vercel.app)
VITE_APP_URL=https://your-app.vercel.app
